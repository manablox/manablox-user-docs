{
  "name": "@manablox/user-docs",
  "version": "0.50.0",
  "private": true,
  "license": "MIT",
  "description": "The Manablox user guide, docs.manablox.io.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manablox/manablox-user-docs.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev --port 3008",
    "build": "astro build",
    "preview": "astro preview --port 3008",
    "typecheck": "astro check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "knip": "knip --no-progress",
    "docs:words": "node scripts/check-docs-words.mjs",
    "links": "node scripts/check-links.mjs dist",
    "links:cross": "node scripts/check-external-docs-links.mjs dist",
    "check": "pnpm lint && pnpm knip && pnpm docs:words && pnpm typecheck && pnpm build && pnpm links",
    "dev:up": "./scripts/dev.sh up",
    "dev:down": "./scripts/dev.sh down",
    "dev:logs": "./scripts/dev.sh logs",
    "dev:reset": "./scripts/dev.sh reset",
    "dev:services": "./scripts/dev.sh services:up",
    "docker:build": "./scripts/docker-build.sh",
    "prepare": "node scripts/git-hooks.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "catalog:",
    "@manablox/docs-theme": "^0.50.0",
    "astro": "catalog:",
    "astro-mermaid": "^2.1.0",
    "mermaid": "^11.17.2"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@biomejs/biome": "catalog:",
    "knip": "catalog:",
    "simple-git-hooks": "catalog:",
    "typescript": "catalog:astro"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm biome check --staged --no-errors-on-unmatched"
  }
}
