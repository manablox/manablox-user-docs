# The user guide's dev server in the dev compose stack (docker/compose.dev.yml). It reads
# its own `src/content/docs/` from the bind-mounted repository and talks to nothing.
#
# Copy this to `.env`, which is gitignored - `scripts/dev.sh` does that for you the first
# time you bring the stack up.
ASTRO_TELEMETRY_DISABLED=1
